<header>
    <div class="header-title"></div>
    <div class="header-right">
        <p class="user-email">
            <%= userEmail %>
        </p>
        <button id="btnOpenWebRTCShare" class="btn" style="background:#00aaff; color:#000;">Local Share</button>
