<!DOCTYPE html>
<html>

<%- include('partials/head') %>

<style>


@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600&family=Libre+Baskerville&display=swap');

body{
    margin:0;
    background:#0f0a0a;
    color:#e6d3b3;
    font-family:'Libre Baskerville', serif;
}



.page-wrapper{
    display:flex;
    min-height:100vh;
}

.main{
    flex:1;
    padding:30px;
    background:linear-gradient(135deg,#1a0c0c,#120606);
}


h2,h3{
    font-family:'Playfair Display', serif;
    letter-spacing:1px;
}


.breadcrumb{
    margin-bottom:25px;
    font-size:14px;
    color:#c8a97e;
}

.breadcrumb a{
    color:#d4af37;
    text-decoration:none;
}

.breadcrumb a:hover{
    text-decoration:underline;
}


.upload-card{

    background:#160909;
    border:1px solid #3a1a1a;
    padding:22px;
    display: flex;
    align-self: self-start;
    border-radius:10px;
max-width: max-content;
max-height: max-content;
    box-shadow:
    0 0 20px rgba(41, 17, 17, 0.3),
    inset 0 0 10px rgba(0,0,0,0.8);
   justify-items:left;
    margin-bottom:30px;
}

.upload-row{
    display:flex;
    gap:12px;
    margin-top:10px;
}

input[type=file]{
    flex:1;
    padding:8px;
    background:#0f0505;
    border:1px solid #4a1d1d;
    color:#e6d3b3;
}


.btn{

    padding:8px 16px;
    border:none;
    border-radius:6px;
    cursor:pointer;
    font-family:'Libre Baskerville', serif;
    font-size:13px;
}


.btn-upload{
    background:#ff0000;
    color:#f3e2c3;
    block-size: 30%;

}

.btn-download{
    background:#1b3a2b;
    color:#f3e2c3;
}

.btn-delete{
    background:#3f0d0d;
    color:#f3e2c3;
}

.btn-share{
    background:#b70e0e;
    color:#f3e2c3;
}

.btn:hover{
    filter:brightness(1.2);
}


.file-table{

    width:100%;
    border-collapse:collapse;
    background:#120606;

    border:1px solid #030202;
    border-radius:10px;

    overflow:hidden;

    box-shadow:
    0 0 25px rgba(0,0,0,0.8);
}

.file-table th{

    background:#010000;
    color:#d4af37;

    padding:14px;
    text-align:left;

    font-weight:500;
}

.file-table td{

    padding:14px;
    border-top:1px solid #2a1212;
}

.file-table tr:hover{
    background:#1b0b0b;
}


#progressContainer{

    margin-top:15px;
    height:8px;

    background:#000000;
    border-radius:20px;
}

#progressBar{

    width:0%;
    height:100%;

    background:linear-gradient(90deg,#ae1818,#302e2a);
}


::-webkit-scrollbar{
    width:8px;
}

::-webkit-scrollbar-thumb{
    background:#210e0e;
}




</style>


<body>

<%- include('partials/header') %>

<div class="page-wrapper">

<%- include('partials/sidebar') %>

<div class="main">

<div class="breadcrumb">

<a href="<%= (sharedId && sharedId !== 'undefined') ? '/?sharedId='+sharedId : '/' %>">
Home
</a>

<% const parts=(currentPath || "").split("/").filter(Boolean); %>
<% let accumulated=""; %>

<% parts.forEach((p,i)=>{ accumulated+=p+"/"; %>

 / 

<a href="<%= (sharedId && sharedId !== 'undefined') 
? '/?sharedId='+sharedId+'&path='+encodeURIComponent(accumulated) 
: '/?path='+encodeURIComponent(accumulated) %>">

<%= p %>

</a>

<% }) %>

</div>


<div class="upload-card" id="uploadSection">

<h4>Upload Files</h4>

<div class="upload-row">

<input type="file" id="fileInput" multiple required>

<button id="uploadBtn" class="btn btn-upload">
Upload
</button>

</div>

<div id="progressContainer">
<div id="progressBar"></div>
</div>

</div>


<h2 style="margin-bottom:15px;">Files</h2>

<table class="file-table">

<tr>
<th>Filename</th>
<th>Size</th>
<th>Last Modified</th>
<th>Actions</th>
</tr>

<% if(files.length===0){ %>

<tr>
<td colspan="4" style="text-align:center;padding:30px;">
No files uploaded yet
</td>
</tr>

<% } else { %>

<% files.forEach(f=> { %>

<tr>

<td><%= f.name %></td>

<td><%= f.size %></td>

<td><%= f.lastModified %></td>

<td>

<a class="btn btn-download download-file" data-name="<%= f.name %>">
Download
</a>

<a class="btn btn-delete delete-file" data-name="<%= f.name %>">
Delete
</a>

<% if (!sharedId) { %>

<button class="btn btn-share share-file" data-name="<%= f.name %>">
Share
</button>

<% } %>

</td>

</tr>

<% }) %>

<% } %>

</table>

</div>

</div>

<%- include('partials/modals') %>
<%- include('partials/scripts') %>

</body>
</html>