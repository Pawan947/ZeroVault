<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Secure Access Terminal</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600&display=swap"
    rel="stylesheet">
  <style>
    :root {
      --accent: #ef0808;
      --danger: #ff3b3b;
      --panel: #0b0f14;
      --border: #1f2a33;
      --text: #c52323;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: radial-gradient(circle at center, #0a0505 0%, #030406 100%);
      color: var(--text);
      font-family: 'Space Grotesk', Consolas, monospace;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      position: relative;
    }

    body::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background:
        linear-gradient(rgba(239, 8, 8, 0.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(239, 8, 8, 0.025) 1px, transparent 1px);
      background-size: 50px 50px;
      z-index: 0;
      pointer-events: none;
    }

    /* Top Bar */
    #nav {
      height: clamp(50px, 6vh, 70px);
      background: rgba(11, 15, 20, 0.4);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(239, 8, 8, 0.1);
      box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
      display: flex;
      align-items: center;
      padding: 0 2vw;
      letter-spacing: 2px;
      font-size: clamp(12px, 1.2vw, 16px);
      z-index: 10;
    }

    /* Layout */
    #main {
      flex: 1;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: clamp(20px, 5vw, 80px);
      padding: 5vh 5vw;
      flex-wrap: wrap;
      position: relative;
      z-index: 5;

    }

    /* Login */
    #cred {
      width: clamp(280px, 30vw, 400px);
      background: rgba(11, 15, 20, 0.4);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      padding: clamp(30px, 4vw, 45px);
      border: 1px solid rgba(239, 8, 8, 0.15);
      border-radius: 16px;
      display: flex;
      margin-bottom: 250px;
      flex-direction: column;
      gap: clamp(16px, 2.5vh, 22px);
      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.8), inset 0 0 0 1px rgba(255, 255, 255, 0.03);
    }

    #branding {
      text-shadow: 0 0 10px rgba(239, 8, 8, 0.4);
    }

    #cred input {
      background: rgba(0, 0, 0, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 8px;
      padding: clamp(12px, 1.5vw, 16px);
      color: #fff;
      font-family: inherit;
      font-size: clamp(12px, 1vw, 15px);
      width: 100%;
      transition: all 0.3s ease;
      box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.5);
    }

    #cred input:focus {
      border: 1px solid rgba(239, 8, 8, 0.6);
      outline: none;
      box-shadow: 0 0 15px rgba(239, 8, 8, 0.2), inset 0 2px 5px rgba(0, 0, 0, 0.5);
      background: rgba(0, 0, 0, 0.7);
    }

    #cred input::placeholder {
      color: rgba(255, 255, 255, 0.3);
      letter-spacing: 1px;
    }

    #cred button {
      padding: clamp(12px, 1.5vw, 16px);
      background: linear-gradient(135deg, rgba(239, 8, 8, 0.1), rgba(239, 8, 8, 0.02));
      backdrop-filter: blur(10px);
      border: 1px solid rgba(239, 8, 8, 0.4);
      color: #ffcccc;
      border-radius: 8px;
      cursor: pointer;
      font-family: inherit;
      font-size: clamp(12px, 1vw, 14px);
      font-weight: 600;
      letter-spacing: 2px;
      transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
      width: 100%;
      text-shadow: 0 0 8px rgba(239, 8, 8, 0.6);
    }

    #cred button:hover {
      background: rgba(239, 8, 8, 0.25);
      border: 1px solid rgba(239, 8, 8, 0.8);
      color: #fff;
      box-shadow: 0 0 25px rgba(239, 8, 8, 0.4), inset 0 0 15px rgba(239, 8, 8, 0.2);
      transform: translateY(-2px);
    }

    .register-link {
      display: inline-block;
      text-align: center;
      padding: clamp(10px, 1.2vw, 14px);
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: rgba(255, 255, 255, 0.7);
      border-radius: 8px;
      cursor: pointer;
      font-family: inherit;
      font-size: clamp(10px, 0.9vw, 12px);
      font-weight: 500;
      letter-spacing: 2px;
      transition: all 0.3s ease;
      text-decoration: none;
      width: 100%;
    }

    .register-link:hover {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.5);
      color: #fff;
      box-shadow: 0 0 15px rgba(255, 255, 255, 0.1);
      transform: translateY(-1px);
    }

    .error {
      color: var(--danger);
      background: rgba(255, 59, 59, 0.1);
      padding: 10px;
      border: 1px solid var(--danger);
      font-size: 12px;
      text-align: center;
    }

    /* DNA */
    .dna {
      width: clamp(200px, 20vw, 260px);
      height: clamp(800px, 100vh, 1500px);
      perspective: 1000px;
      position: relative;
      opacity: 0.45;
      transform: rotate(25deg);
      transition: opacity 1s ease-in-out;


    }

    .base {
      position: absolute;
      width: 100%;
      height: 20px;
      transform-style: preserve-3d;
      animation: spin 10s linear infinite;
      margin-bottom: 0px;
    }

    .dot {
      position: absolute;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      top: 1px;
      background: var(--accent);
      box-shadow: 0 0 5px var(--accent), 0 0 15px var(--danger), 0 0 25px var(--danger);
      animation: fuljhadi-pulse 0.4s calc(var(--delay, 0) * 1s) infinite alternate;
      z-index: 10;
      will-change: transform, box-shadow, opacity;
    }

    .dot::before,
    .dot::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 3px;
      height: 3px;
      border-radius: 50%;
      background: var(--danger);
      box-shadow: 0 0 8px var(--accent), 0 0 12px var(--danger);
      opacity: 0;
      pointer-events: none;
      animation: shoot-sparks 1s linear infinite;
      will-change: transform, opacity;
    }

    .dot::before {
      animation-delay: calc(var(--delay, 0) * 2s);
    }

    .dot::after {
      animation-delay: calc(var(--delay, 0) * 1.5s + 0.3s);
      animation-duration: 1.3s;
      width: 2px;
      height: 2px;
    }

    @keyframes fuljhadi-pulse {
      0% {
        box-shadow: 0 0 5px var(--accent), 0 0 10px var(--danger), 0 0 15px var(--danger);
        transform: scale(0.8);
        opacity: 0.6;
      }

      100% {
        box-shadow: 0 0 10px #fff, 0 0 20px var(--accent), 0 0 35px var(--danger), 0 0 50px var(--danger);
        transform: scale(1.4);
        background: #ffcccc;
        opacity: 0.9;
      }
    }

    @keyframes shoot-sparks {
      0% {
        transform: translate(-50%, -50%) scale(1);
        opacity: 1;
      }

      100% {
        transform: translate(calc(-50% + var(--spark-x)), calc(-50% + var(--spark-y))) scale(0);
        opacity: 0;
      }
    }

    .left {
      left: 20%;
    }

    .right {
      right: 20%;
    }

    .connector {
      position: absolute;
      top: 3px;
      left: 25%;
      width: 50%;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--accent), transparent);
      opacity: 0.3;
      box-shadow: 0 0 3px var(--accent);
      animation: fuljhadi-link 1s calc(var(--delay, 0) * 1s) infinite alternate;
    }

    @keyframes fuljhadi-link {
      0% {
        opacity: 0.15;
        filter: brightness(1);
      }

      100% {
        opacity: 0.45;
        filter: brightness(1.2);
      }
    }

    @keyframes spin {
      to {
        transform: rotateY(360deg);
      }
    }

    /* Hide DNA on small screens */
    @media (max-width:768px) {
      .dna {
        display: none;
      }
    }

    /* Popup */
    #popupOverlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      display: none;
      justify-content: center;
      align-items: center;
      padding: 20px;
      z-index: 100;
    }

    #popupOverlay.active {
      display: flex;
    }

    #popupBox {
      width: clamp(300px, 40vw, 500px);
      background: rgba(11, 15, 20, 0.6);
      backdrop-filter: blur(24px);
      border: 1px solid rgba(239, 8, 8, 0.15);
      border-radius: 16px;
      padding: clamp(30px, 4vw, 45px);
      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.8), inset 0 0 0 1px rgba(255, 255, 255, 0.03);
    }

    #popupBox h2 {
      margin: 0 0 15px;
      font-size: clamp(14px, 1.2vw, 18px);
      letter-spacing: 2px;
      text-shadow: 0 0 8px rgba(239, 8, 8, 0.4);
    }

    #status {
      font-size: clamp(12px, 1vw, 14px);
      opacity: .8;
      margin-bottom: 20px;
    }

    /* Hardware */
    .hardware {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      justify-content: center;
    }

    .device {
      flex: 1 1 150px;
      background: rgba(0, 0, 0, 0.4);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 12px;
      padding: 20px;
      text-align: center;
      cursor: pointer;
      transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .device:hover {
      background: rgba(239, 8, 8, 0.05);
      border: 1px solid rgba(239, 8, 8, 0.5);
      box-shadow: 0 0 20px rgba(239, 8, 8, 0.15);
      transform: translateY(-2px);
    }

    .device.active {
      background: rgba(239, 8, 8, 0.1);
      border: 1px solid var(--accent);
      box-shadow: 0 0 25px rgba(239, 8, 8, 0.3), inset 0 0 10px rgba(239, 8, 8, 0.15);
      transform: translateY(-2px);
    }

    .device-title {
      font-size: clamp(10px, 1vw, 13px);
      margin-bottom: 10px;
      letter-spacing: 1px;
    }

    .usb-slot {
      width: 50px;
      height: 20px;
      margin: 0 auto;
      border: 2px solid var(--accent);
    }

    .scanner {
      width: 50px;
      height: 50px;
      margin: 0 auto;
      border: 2px solid var(--accent);
      position: relative;
      overflow: hidden;
    }

    .scan-line {
      position: absolute;
      width: 100%;
      height: 3px;
      background: var(--accent);
      top: -10px;
      animation: scan 2s linear infinite;
    }

    @keyframes scan {
      to {
        top: 100%;
      }
    }

    .loader {
      margin-top: 20px;
      height: 2px;
      background: var(--accent);
      width: 0%;
      transition: width 2s linear;
    }

    #cancelBtn {
      margin-top: 25px;
      padding: 12px;
      background: transparent;
      border: 1px solid var(--danger);
      color: var(--danger);
      border-radius: 8px;
      cursor: pointer;
      width: 100%;
      font-family: inherit;
      font-weight: 600;
      letter-spacing: 2px;
      transition: all 0.3s ease;
    }

    #cancelBtn:hover {
      background: rgba(255, 59, 59, 0.15);
      box-shadow: 0 0 15px rgba(255, 59, 59, 0.3);
    }





    .butterfly {
      animation: hover 250ms cubic-bezier(.48, .01, .54, 1) infinite alternate-reverse;
      position: relative;
      transform-style: preserve-3d;
      transform: rotateX(50deg) rotateY(20deg) rotateZ(-50deg) translateY(0px);
      width: 30px;
    }

    .butterfly::before {
      background: var(--panel);
      border: 1px solid rgba(239, 8, 8, 0.5);
      box-shadow: 0 0 15px rgba(239, 8, 8, 0.3);
      border-radius: 50%;
      content: '';
      display: block;
      height: 110px;
      left: 50%;
      margin-left: -10px;
      position: absolute;
      top: -15px;
      transform: rotatey(100deg);
      width: 20px;
      z-index: 2;
    }

    .shadow {
      animation: shadow 250ms cubic-bezier(.48, .01, .54, 1) infinite alternate-reverse;
      background: #000;
      border-radius: 50%;
      display: block;
      height: 10px;
      opacity: 0.1;
      transform-origin: 50% 50%;
      transform: translateX(-40px) translateY(100px);
      width: 100px;
    }

    .wing {
      display: block;
      position: absolute;
      top: 0;
    }

    .wing:first-child {
      animation: leftflap 250ms cubic-bezier(.48, .01, .54, 1) infinite alternate-reverse;
      height: 1px;
      left: 0;
      transform: rotateY(-20deg);
      transform-origin: 700% 50%;
      width: 1px;
      z-index: 3;
    }

    .wing:last-child {
      animation: rightflap 250ms cubic-bezier(.48, .01, .54, 1) infinite alternate-reverse;
      right: 0;
      transform: rotateY(200deg);
      z-index: 1;
    }

    .wing .bit {
      background: rgba(239, 8, 8, 0.15);
      backdrop-filter: blur(5px);
      -webkit-backdrop-filter: blur(5px);
      border: 1px solid rgba(239, 8, 8, 0.6);
      box-shadow: inset 0 0 15px rgba(239, 8, 8, 0.3), 0 0 10px rgba(239, 8, 8, 0.2);
    }

    .wing .bit::after {
      background: rgba(239, 8, 8, 0.25);
      border: 1px solid rgba(239, 8, 8, 0.4);
      box-shadow: inset 0 0 10px rgba(239, 8, 8, 0.2);
    }

    .wing .bit,
    .wing .bit::after {
      border-radius: 50%;
      position: absolute;
      right: 0;
      top: 0;
      transform-origin: 100% 50%;
    }

    .wing .bit:first-child {
      height: 70px;
      text-align: center;
      top: 15px;
      transform: rotateZ(40deg);
      width: 130px;
    }

    .wing .bit:first-child::after {
      content: '';
      display: inline-block;
      height: 60px;
      left: -30px;
      top: 5px;
      width: 100px;
    }

    .wing .bit:last-child {
      height: 55px;
      transform: rotateZ(-40deg);
      width: 100px;
    }

    .wing .bit:last-child::after {
      content: '';
      display: inline-block;
      height: 45px;
      left: -24px;
      top: 5px;
      width: 60px;
      z-index: 1;
    }

    @keyframes hover {
      0% {
        transform: rotateX(50deg) rotateY(20deg) rotateZ(-50deg) translateZ(0px);
      }

      100% {
        transform: rotateX(50deg) rotateY(20deg) rotateZ(-50deg) translateZ(-3px);
      }
    }

    @keyframes shadow {
      0% {
        transform: translateX(-40px) translateY(100px) scale(1, 1);
      }

      100% {
        transform: translateX(-40px) translateY(100px) scale(1.1, 1.1);
      }
    }

    @keyframes leftflap {
      0% {
        transform: rotateY(-20deg);
      }

      100% {
        transform: rotateY(90deg);
      }
    }

    @keyframes rightflap {
      0% {
        transform: rotateY(200deg);
      }

      100% {
        transform: rotateY(90deg);
      }
    }

    .twitter {
      background: #4099FF;
      border-radius: 5px;
      bottom: 5px;
      color: #fff;
      font-family: sans-serif;
      font-size: 13px;
      padding: 5px 10px;
      position: absolute;
      right: 5px;
      text-decoration: none;
    }

    .twitter:hover {
      background: #55aaff;
    }
  </style>
</head>

<body>

  <div id="nav">
    <i class="fas fa-shield-alt" style="font-size: 40px; color: var(--accent); margin-bottom: 10px;"></i>
    ZERO VAULT
  </div>

  <div id="main">













    <div id="cred">
      <div id="branding" style="text-align:center; margin-bottom: 15px;">

        <div style="font-size: 18px; letter-spacing: 2px;">AUTHENTICATION</div>
      </div>

      <% if (error) { %>
        <div class="error">
          <%= error %>
        </div>
        <% } %>

          <form action="/login" method="POST" id="loginForm">
            <div style="display:flex; flex-direction:column; gap: 15px;">
              <input type="email" name="email" placeholder="IDENTITY ID" required>
              <input type="password" name="password" placeholder="ACCESS CODE" required>
              <button type="submit" id="startBtn">INITIATE AUTH</button>
              <a href="/register" class="register-link">REQUEST ACCESS (REGISTER)</a>
            </div>
          </form>

          <div style="margin: 5px 0; text-align: center; font-size: 10px; opacity: 0.5;">SECURE CONNECTION
            ESTABLISHED
          </div>


    </div>





    <div id="butterfly-wrapper"
      style="position: fixed; left: 0; top: 0; pointer-events: none; z-index: 9999; transform: scale(0.35);">
      <div id="butterfly-rotator" style="transform-origin: center;">
        <div class="butterfly">
          <div class="wing">
            <div class="bit"></div>
            <div class="bit"></div>
          </div>
          <div class="wing">
            <div class="bit"></div>
            <div class="bit"></div>
          </div>
        </div>
      </div>
      <div class="shadow" id="butterfly-shadow"></div>
    </div>
    <a href="https://bsky.app/profile/beets.irish" class="twitter" target="_blank">@beets.irish</a>




    <div class="dna" id="dna"></div>
  </div>

  <div id="popupOverlay">
    <div id="popupBox">
      <h2>PASSKEY AUTHENTICATION</h2>
      <div id="status">Awaiting hardware interaction...</div>

      <div class="hardware">
        <div class="device" id="usbDevice">
          <div class="device-title">USB SECURITY TOKEN</div>
          <div class="usb-slot"></div>
        </div>

        <div class="device" id="bioDevice">
          <div class="device-title">BIOMETRIC SCANNER</div>
          <div class="scanner">
            <div class="scan-line"></div>
          </div>
        </div>
      </div>

      <div class="loader" id="loaderBar"></div>
      <button id="cancelBtn">ABORT</button>
    </div>
  </div>

  <script src="https://unpkg.com/@simplewebauthn/browser/dist/bundle/index.umd.min.js"></script>
  <script>
    const dnaContainer = document.getElementById("dna");
    for (let i = 0; i < 18; i++) {
      const base = document.createElement("div");
      base.className = "base";
      base.style.top = `${i * 5}%`;
      base.style.animationDelay = `${i * .3}s`;
      const sX1 = (Math.random() - 0.5) * 120 + 'px';
      const sY1 = (Math.random() - 0.5) * 120 + 'px';
      const sX2 = (Math.random() - 0.5) * 120 + 'px';
      const sY2 = (Math.random() - 0.5) * 120 + 'px';

      base.innerHTML = `
    <div class="dot left" style="--delay: ${Math.random()}; --spark-x: ${sX1}; --spark-y: ${sY1}"></div>
    <div class="connector" style="--delay: ${Math.random()}"></div>
    <div class="dot right" style="--delay: ${Math.random()}; --spark-x: ${sX2}; --spark-y: ${sY2}"></div>
  `;
      dnaContainer.appendChild(base);
    }

    const { startAuthentication } = SimpleWebAuthnBrowser;
    const overlay = document.getElementById("popupOverlay");
    const usbDevice = document.getElementById("usbDevice");
    const bioDevice = document.getElementById("bioDevice");
    const loaderBar = document.getElementById("loaderBar");
    const statusText = document.getElementById("status");
    const loginForm = document.getElementById('loginForm');
    const startBtn = document.getElementById('startBtn');

    // Show the popup overlay
    function showPopup() {
      overlay.classList.add("active");
      statusText.textContent = "Awaiting hardware interaction...";
      loaderBar.style.width = "0%";
      usbDevice.classList.remove("active");
      bioDevice.classList.remove("active");
    }

    // Close the popup overlay
    function closePopup() {
      overlay.classList.remove("active");
      loaderBar.style.width = "0%";
    }

    // This handles the actual authentication logic
    async function performAuthentication(device) {
      if (!loginForm.checkValidity()) {
        loginForm.reportValidity();
        closePopup();
        return;
      }

      try {
        // Visual feedback
        usbDevice.classList.remove("active");
        bioDevice.classList.remove("active");
        if (device) device.classList.add("active");

        statusText.textContent = "Handshaking with Zero Vault...";
        loaderBar.style.transition = "width 2s linear";
        loaderBar.style.width = "50%"; // Mid-point for first factor

        const formData = new FormData(loginForm);
        const data = Object.fromEntries(formData.entries());

        // Step 1: Standard Login check
        const resp = await fetch('/login', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'Accept': 'application/json'
          },
          body: new URLSearchParams(data)
        });

        const result = await resp.json();

        if (result.success) {
          statusText.textContent = "Identity verified. Accessing...";
          loaderBar.style.width = "100%";
          setTimeout(() => window.location.href = '/', 1000);
        } else if (result.mfaRequired) {
          // Step 2: WebAuthn MFA if required
          statusText.textContent = "Identity verified. Awaiting Passkey...";
          loaderBar.style.width = "75%";

          const optsResp = await fetch('/api/webauthn/login-options');
          const opts = await optsResp.json();
          if (opts.error) throw new Error(opts.error);

          const asseResp = await startAuthentication({ optionsJSON: opts });

          const verifyResp = await fetch('/api/webauthn/login-verify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(asseResp),
          });

          const verifyResult = await verifyResp.json();

          if (verifyResult.verified) {
            statusText.textContent = "Multi-factor authentication complete.";
            loaderBar.style.width = "100%";
            setTimeout(() => window.location.href = '/', 1000);
          } else {
            throw new Error(verifyResult.error || "Passkey verification failed");
          }
        } else {
          throw new Error(result.error || "Invalid credentials");
        }
      } catch (err) {
        console.error(err);
        statusText.textContent = "ERROR: " + err.message;
        loaderBar.style.width = "0%";
        if (err.name !== 'AbortError') {
          setTimeout(() => alert("Access Denied: " + err.message), 500);
        }
      }
    }

    // Wire up events
    startBtn.onclick = (e) => {
      e.preventDefault();
      if (loginForm.checkValidity()) {
        showPopup();
      } else {
        loginForm.reportValidity();
      }
    };

    usbDevice.onclick = () => performAuthentication(usbDevice);
    bioDevice.onclick = () => performAuthentication(bioDevice);
    document.getElementById("cancelBtn").onclick = closePopup;


    // --- BUTTERFLY AI BEHAVIOR LOGIC ---
    const bWrapper = document.getElementById('butterfly-wrapper');
    const bRotator = document.getElementById('butterfly-rotator');

    let cx = window.innerWidth / 2;
    let cy = window.innerHeight / 2;

    let bx = window.innerWidth / 2;
    let by = window.innerHeight / 2;
    let vx = 0;
    let vy = 0;

    let currentAngle = 0;
    let lastTime = performance.now();

    // Cache obstacle rects to avoid layout thrashing (reflow) in the animation loop
    let cachedObstacles = [];
    function updateObstacles() {
      const obstacleEls = [
        document.getElementById('nav'),
        document.getElementById('cred'),
        document.getElementById('dna')
      ].filter(Boolean);

      cachedObstacles = obstacleEls.map(el => {
        const rect = el.getBoundingClientRect();
        return {
          ex: rect.left + rect.width / 2,
          ey: rect.top + rect.height / 2,
          radius: Math.max(rect.width, rect.height) / 2 + 100
        };
      });
    }

    // Initialize cache and update on resize
    updateObstacles();
    window.addEventListener('resize', updateObstacles);
    setTimeout(updateObstacles, 500); // Late re-calc in case fonts/styles shift

    function animateButterfly(timestamp) {
      requestAnimationFrame(animateButterfly);

      if (!timestamp) timestamp = performance.now();
      const dt = Math.min((timestamp - lastTime) / 16.666, 3); // normalize to 60fps frame
      lastTime = timestamp;

      let time = timestamp * 0.001;

      // Natural slow drift across the screen instead of following cursor
      cx = window.innerWidth / 2 + Math.sin(time * 0.2) * (window.innerWidth * 0.35);
      cy = window.innerHeight / 2 + Math.cos(time * 0.15) * (window.innerHeight * 0.35);

      // Add randomized wandering for natural flutter
      let wanderX = Math.sin(time * 0.8) * 150 + Math.cos(time * 0.5) * 100;
      let wanderY = Math.cos(time * 0.7) * 150 + Math.sin(time * 0.6) * 100;

      let tx = cx + wanderX;
      let ty = cy + wanderY;
      let accel = 0.005; // Lazy drifting acceleration

      // Surroundings awareness: Avoid elements like DNA, NavBar, Login box
      cachedObstacles.forEach(obs => {
        let dx = bx - obs.ex;
        let dy = by - obs.ey;
        let dist = Math.sqrt(dx * dx + dy * dy);

        if (dist > 0 && dist < obs.radius) {
          let force = Math.pow((obs.radius - dist) / obs.radius, 1.5);
          tx += (dx / dist) * force * 500;
          ty += (dy / dist) * force * 500;
        }
      });

      // Stay within viewport margins
      const margin = 40;
      tx = Math.max(margin, Math.min(window.innerWidth - margin, tx));
      ty = Math.max(margin, Math.min(window.innerHeight - margin, ty));

      // Steering forces (framerate independent)
      let ax = (tx - bx) * accel;
      let ay = (ty - by) * accel;

      vx += ax * dt;
      vy += ay * dt;

      // Fluid friction (framerate independent scaling)
      vx *= Math.pow(0.92, dt);
      vy *= Math.pow(0.92, dt);

      bx += vx * dt;
      by += vy * dt;

      bWrapper.style.transform = `translate3d(${bx.toFixed(2)}px, ${by.toFixed(2)}px, 0) scale(0.35)`;

      // Directional rotation
      const speed = Math.sqrt(vx * vx + vy * vy);
      if (speed > 0.5) {
        let angle = Math.atan2(vy, vx) * 180 / Math.PI;

        let diff = angle - currentAngle;
        while (diff > 180) diff -= 360;
        while (diff < -180) diff += 360;

        // Soft, organic turning
        currentAngle += diff * Math.min(0.04 * dt, 1);

        bRotator.style.transform = `rotate(${currentAngle + 90}deg)`;
      } else {
        // slight jitter when hovering
        bRotator.style.transform = `rotate(${currentAngle + 90 + Math.sin(time * 5) * 3}deg)`;
      }
    }

    requestAnimationFrame(animateButterfly);



  </script>

</body>

